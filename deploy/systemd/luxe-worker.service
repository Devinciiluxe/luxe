[Unit]
Description=LUXE Airbnb browser_jobs worker (Lightpanda → Supabase)
Documentation=file:///opt/luxe-mstr-rebuild/luxe-cortex/docs/vm-systemd-units.md
After=network-online.target luxe-lightpanda.service
Wants=network-online.target
Requires=luxe-lightpanda.service

[Service]
Type=simple
User=luxecortex
Group=luxecortex
WorkingDirectory=/opt/luxe-mstr-rebuild/worker
EnvironmentFile=/opt/luxe-mstr-rebuild/worker/.env
# Dry-run stays default until Jarvis arms via GO FOR IT (settings.pipeline_live).
# Do NOT set LUXE_PIPELINE_LIVE=1 here — that env override skips the phrase gate.
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
StartLimitIntervalSec=0
# Polls Supabase; no inbound ports.

[Install]
WantedBy=multi-user.target
