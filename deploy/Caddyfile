# Reverse proxy for JARVIS CORTEX on the SSH VM.
# Replace cortex.yourdomain.com with the hostname whose A/AAAA record
# points at this VM. Caddy issues Let's Encrypt certs automatically.
#
# Install: sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

cortex.yourdomain.com {
	encode gzip
	reverse_proxy 127.0.0.1:8787
}
